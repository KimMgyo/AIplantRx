# Copy to .env for local runs; in Dokploy set these as service environment
# variables instead. Never commit the filled-in version.

# Shared secret the device sends as `Authorization: Bearer <token>`.
# Leave empty in development; the server then accepts unauthenticated requests
# and says so at startup.
PLANTRX_TOKEN=

# Google AI Studio key. Without it the server still stores telemetry and serves
# the last prescription, it just never produces a new one.
GEMINI_API_KEY=
PLANTRX_MODEL=gemini-2.5-flash

# PlantNet keys, comma separated. 500 requests/day each; the server rotates when
# one is exhausted. These used to be compiled into include/plantnet_config.h on
# the device; that header is gone and the panel now POSTs its photo to
# /v1/identify instead, so this is the only place the keys exist. Without them
# that endpoint answers 키 미설정 and the automatic path falls back to whatever
# the last prescription already said.
PLANTNET_API_KEYS=

# SQLite location. Must sit on a mounted volume in Dokploy.
PLANTRX_DB=/srv/data/plantrx.db

PLANTRX_LOG=INFO
